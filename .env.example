# Base de données PostgreSQL
DATABASE_URL="postgresql://jeunes_mims:jeunes_mims@localhost:5433/jeunes_mims?schema=public"
# Sur Neon : connexion directe (non poolée), utilisée uniquement pour les
# migrations Prisma (`migrate dev` / `migrate deploy`). En local sans Neon,
# reprends simplement la même valeur que DATABASE_URL.
DATABASE_URL_UNPOOLED="postgresql://jeunes_mims:jeunes_mims@localhost:5433/jeunes_mims?schema=public"

# Serveur
PORT=4000
CORS_ORIGIN="http://localhost:3000"

# Sécurité
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="12h"

# Stockage des fichiers (reçus, documents, avatars, annonces)
# Développement : dossier local. Production : brancher un adaptateur S3 / Supabase Storage.
STORAGE_ROOT="./storage"

# Notifications Web Push (VAPID) — génère TA PAIRE avant la mise en production :
#   npx web-push generate-vapid-keys
# La clé publique doit être recopiée telle quelle dans web/.env.local
# (NEXT_PUBLIC_VAPID_PUBLIC_KEY). Sans ces clés, les notifications restent
# visibles dans l'app mais ne s'affichent plus sur l'appareil hors de l'app.
VAPID_PUBLIC_KEY="BCB8__XgigZepU6s-QPuROFRrxna-lwC3xq80pqHeL-bUR2mRhrQCUMOqFjaMxs_kh1_-tqoY2v2eJp7NurFQXM"
VAPID_PRIVATE_KEY="r4IYMmv1jis0fM4ZlGBa-IKoYsa1KAjGx_lV3hsRYCg"
